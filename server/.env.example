# Fill these in server/.env before starting the server. Keep server/.env private.
WEB_ACCESS_CODE=
AUTH_SESSION_SECRET=
PUBLIC_ORIGIN=https://your-tunnel.example
HOST=127.0.0.1
SYNC_CODE=eric-fuhan
# WEB_ACCESS_CODE needs at least 24 characters; AUTH_SESSION_SECRET needs at least 32.
# Use random values. Access code is a login/Bearer secret, never a frontend constant.
REQUESTS_PER_MINUTE=600
AUTH_LOGIN_MAX_FAILURES=8
BOOK_UPLOAD_MAX_BYTES=16777216
BOOK_UPLOAD_CONCURRENCY=1
PROGRESS_MAX_RECORDS=2000
SECURITY_LOG_MAX_BYTES=2097152
SECURITY_LOG_FILES=7
DASHSCOPE_API_KEY=
SFM_WORKSPACE_ID=
TTS_ACCESS_CODE=
# Daily reset uses Asia/Shanghai. Cached audio does not consume generation quota.
TTS_DAILY_MAX_CHARS=300000
TTS_DAILY_MAX_REQUESTS=3000
TTS_DAILY_BUDGET_CNY=5
# Pre-reserve estimated cost per in-flight request; final provider usage settles it.
# A provider charge above this estimate can overshoot the budget for that request.
TTS_REQUEST_RESERVE_CNY=0.10
