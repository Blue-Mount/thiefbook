{
  "name": "thiefbook-desktop",
  "version": "1.1.3",
  "description": "摸鱼看书 · Win11 桌面隐蔽阅读器（Electron）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "pwsh.exe -NoProfile -File ./build-release.ps1"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bluemount.thiefbook",
    "asar": false,
    "productName": "thiefbook",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "../app/public/books",
        "to": "books",
        "filter": ["fuhan.json"]
      }
    ],
    "win": {
      "signAndEditExecutable": false
    }
  }
}
